# ---------------------------------------------------------------- General
TZ=America/Caracas
NODE_ENV=production
APP_ENVIRONMENT=dev
WEB_PORT=8080

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=fabrihub
POSTGRES_USER=fabrihub_owner
POSTGRES_PASSWORD=cambiar-owner-123
# Rol de la aplicación: sólo DML (SELECT/INSERT/UPDATE/DELETE + EXECUTE), sin DDL
APP_DB_USER=fabrihub_app
APP_DB_PASSWORD=cambiar-app-123

# ---------------------------------------------------------------- Seguridad / sesión
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=cambiar-por-64-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Intentos de login/OTP por IP cada 15 min (frena el rociado de contraseñas)
AUTH_RATE_LIMIT=30
PASSWORD_HISTORY=5
# true detrás de HTTPS; false sólo en localhost
COOKIE_SECURE=false

# ---------------------------------------------------------------- Front (se embeben en el bundle)
VITE_PUBLIC_ENCRIP_KEY=cambiar-clave-aes-storage
VITE_APP_VERSION=0.1.0

# ---------------------------------------------------------------- Correo (mailpit en desarrollo)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=FabriHub <no-reply@fabrihub.local>
# URL con la que los usuarios abren FabriHub (enlaces de los correos de alertas)
APP_PUBLIC_URL=http://localhost:8080
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------- Usuario administrador inicial
ADMIN_EMAIL=admin@fabrihub.local
ADMIN_INITIAL_PASSWORD=4

# ---------------------------------------------------------------- pgAdmin (perfil tools)
PGADMIN_EMAIL=admin@fabrihub.local
PGADMIN_PASSWORD=cambiar-pgadmin
PGADMIN_PORT=5050
