# =====================================================================
#  FabriHub · variables de PRODUCCIÓN
#  cp .env.production.example .env.production   y reemplazar TODO lo marcado con «CAMBIAR».
#  Los secretos se generan en el servidor con:   openssl rand -hex 32
#  Este archivo real (.env.production) NUNCA va al repositorio (.gitignore).
# =====================================================================

# ---------------------------------------------------------------- Publicación
# Sin dominio propio: <ip-con-guiones>.sslip.io apunta solo a la IP. Con dominio: fabrihub.midominio.com
DOMAIN=217-71-200-20.sslip.io
# Correo para el aviso de vencimiento del certificado (Let's Encrypt)
ACME_EMAIL=CAMBIAR@correo.com
APP_PUBLIC_URL=https://217-71-200-20.sslip.io

# ---------------------------------------------------------------- General
TZ=America/Caracas
NODE_ENV=production
APP_ENVIRONMENT=prod
# No se publica en producción (Caddy usa la red interna); el compose base lo exige.
WEB_PORT=8080

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=fabrihub
POSTGRES_USER=fabrihub_owner
POSTGRES_PASSWORD=CAMBIAR-openssl-rand-hex-32
APP_DB_USER=fabrihub_app
APP_DB_PASSWORD=CAMBIAR-openssl-rand-hex-32

# ---------------------------------------------------------------- Seguridad / sesión
JWT_ACCESS_SECRET=CAMBIAR-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT=30
PASSWORD_HISTORY=5
# Obligatorio con HTTPS: la cookie de sesión solo viaja cifrada
COOKIE_SECURE=true

# ---------------------------------------------------------------- Front (se embeben en el bundle)
VITE_PUBLIC_ENCRIP_KEY=CAMBIAR-openssl-rand-hex-32
VITE_APP_VERSION=1.0.0

# ---------------------------------------------------------------- Correo real (OTP, contraseñas, alertas)
# Ejemplo con Brevo (gratis 300/día): smtp-relay.brevo.com, puerto 587, usuario y clave SMTP de su panel.
# SMTP_FROM debe ser un remitente verificado en el proveedor.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR
SMTP_PASSWORD=CAMBIAR
SMTP_FROM=FabriHub <CAMBIAR@correo.com>
# No se usa en producción (mailpit no se levanta); el compose base lo exige.
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------- Administrador inicial
# Un correo REAL: ahí llega el código OTP del primer ingreso.
ADMIN_EMAIL=CAMBIAR@correo.com
# Temporal: el sistema obliga a cambiarla al entrar (10+ caracteres, mayúscula, número y símbolo)
ADMIN_INITIAL_PASSWORD=CAMBIAR-Temporal.2026

# ---------------------------------------------------------------- pgAdmin (no se usa en producción)
PGADMIN_EMAIL=admin@localhost.local
PGADMIN_PASSWORD=CAMBIAR
PGADMIN_PORT=5050
