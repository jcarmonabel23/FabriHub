{
  "name": "fabrihub-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FabriHub - Servicios de usuario (SPA + servidor Express con proxy /api)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --packages=external --format=esm --outfile=server.mjs",
    "start": "tsx server.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "^8.3.15",
    "@mantine/dates": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@mantine/modals": "^8.3.15",
    "@mantine/notifications": "^8.3.15",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
